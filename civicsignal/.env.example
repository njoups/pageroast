# Copy to .env for docker compose. Never commit real values.
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# Comma-separated browser origins allowed to make mutating requests (CSRF origin check)
APP_ORIGINS=http://localhost:3000
# Keep true. Browsers accept Secure cookies on http://localhost; staging/production must use HTTPS.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts connector credentials; keep it out of the database.
CREDENTIALS_KEY=
# Identify your crawler to publishers, with a contact URL or email.
INGESTION_USER_AGENT=CivicSignalBot/0.2 (+mailto:ops@your-organisation.example)
# AI analysis (see docs/AI_PROVIDERS.md). Leave the key empty to use the rule-based baseline (no external calls).
# The key stays on the server (API + worker); it is never sent to the browser or stored in the database.
ANTHROPIC_API_KEY=
# anthropic | baseline (default: anthropic when a key is set, else baseline). "test" is refused in production.
AI_PROVIDER=
# Model id; the default is set in apps/api/src/config.ts. Change it here, not in code.
AI_MODEL=
# baseline (default): on provider outage or refusal, fall back to the rule-based analyser and mark the result "partial".
# none: mark the analysis failed instead.
AI_FALLBACK=baseline
# Alerts and notifications (docs/NOTIFICATIONS.md). Without SMTP, email deliveries are recorded as "unconfigured".
APP_BASE_URL=http://localhost:3000
SMTP_URL=
EMAIL_FROM=
# Optional: official WhatsApp Business Cloud API (approved template required)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Analytics and reports (docs/ANALYTICS_METHODOLOGY.md, docs/REPORT_TEMPLATES.md). Defaults shown.
# ANALYTICS_REFRESH_INTERVAL_MS=120000
# ANALYTICS_CACHE_TTL_SECONDS=900
# ANALYTICS_MAX_PERIOD_DAYS=366
# REPORT_ARTIFACT_TTL_DAYS=30
# REPORT_RUNS_PER_DAY=50
# REPORT_CONCURRENT_RUNS=3
# REPORT_CSV_ROW_LIMIT=5000
# REPORT_ATTEMPTS=3
# REPORT_STALE_RUN_MINUTES=15
# REPORT_QUEUED_TIMEOUT_MINUTES=120
