# One-shot migrate job only (infra/compose.production.yml → CIVICSIGNAL_MIGRATE_ENV_FILE). TEMPLATE ONLY.
# The owner role creates and alters schema; long-running services never receive it.
NODE_ENV=production
MIGRATION_DATABASE_URL=postgres://civicsignal_owner:<from-secret-manager>@<db-host>:5432/civicsignal
# Sets/rotates the restricted civicsignal_app role's password to match DATABASE_URL in the app env file.
APP_DB_PASSWORD=<from-secret-manager>
