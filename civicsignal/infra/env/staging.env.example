# CivicSignal STAGING runtime settings for api, worker and web (infra/compose.production.yml → CIVICSIGNAL_ENV_FILE).
# TEMPLATE ONLY: variable names and safe placeholders. Real values live in the secret manager, which writes this file
# onto the host (mode 0600, owner root) at deploy time. Never commit a filled copy. Every value differs from production; staging never holds production data or keys.
# Startup validation (apps/api/src/config.ts) refuses to start when a required value is missing or unsafe.

# ── Environment (required) ───────────────────────────────────────────────────────────────────────────────────────
APP_ENV=staging
NODE_ENV=production
APP_ORIGINS=https://staging.<your-domain>
APP_BASE_URL=https://staging.<your-domain>
COOKIE_SECURE=true
TRUST_PROXY=true

# ── Data stores (required). Restricted application role only: no owner credentials here. ─────────────────────────
# Managed PostgreSQL: add ?sslmode=verify-full&sslrootcert=/path/to/ca.pem when the provider gives a CA bundle.
DATABASE_URL=postgres://civicsignal_app:<from-secret-manager>@<db-host>:5432/civicsignal
DATABASE_POOL_MAX=10
REDIS_URL=rediss://:<from-secret-manager>@<redis-host>:6379/0

# ── Keys (required) ──────────────────────────────────────────────────────────────────────────────────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Losing it makes stored connector credentials unreadable.
CREDENTIALS_KEY=<from-secret-manager>
# >= 32 characters; the monitoring scraper sends it as a bearer token to the internal /metrics endpoint.
METRICS_TOKEN=<from-secret-manager>

# ── Email (required: password reset, alerts, reports) ────────────────────────────────────────────────────────────
SMTP_URL=smtps://<user>:<from-secret-manager>@<smtp-relay>:465
EMAIL_FROM=alerts@<your-domain>

# ── AI (optional). Without a key the rule-based baseline runs and results are labelled as such. ──────────────────
AI_PROVIDER=baseline
ANTHROPIC_API_KEY=
AI_MODEL=
AI_FALLBACK=baseline
AI_REQUESTS_PER_MINUTE=5

# ── Billing: no live payment provider adapter exists. Contracts and manual invoices only. ────────────────────────
BILLING_PROVIDER=test
BILLING_TEST_WEBHOOK_SECRET=<from-secret-manager, 24+ characters>
COMMERCIAL_TRIAL_PLAN=trial
INVOICE_NUMBER_PREFIX=INV
BILLING_SALES_EMAIL=

# ── Optional channels and crawler identity ───────────────────────────────────────────────────────────────────────
INGESTION_USER_AGENT=CivicSignalBot/1.0 (+mailto:ops@<your-domain>)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# ── Staging safety (required): outbound messages only to the team ───────────────────────────────────────────────
# Email goes only to these domains or addresses (startup fails without this list).
NOTIFY_ALLOWED_EMAIL_DOMAINS=<your-domain>
# Webhooks and WhatsApp are blocked unless listed (hosts / E.164 numbers of test receivers you own).
NOTIFY_ALLOWED_WEBHOOK_HOSTS=
NOTIFY_ALLOWED_PHONE_NUMBERS=
# Billing: the HMAC test simulator only (no real payments; scripts/billing-test-event.mjs sends signed test events).
# AI: keep the baseline, or set a staging-only key with a low per-tenant monthly token limit (docs/AI_PROVIDERS.md).
# The API docs may be enabled here for testing: API_DOCS_ENABLED=true
